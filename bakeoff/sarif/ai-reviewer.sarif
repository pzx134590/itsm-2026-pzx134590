{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ai-reviewer",
          "informationUri": "https://github.com/swasik/itsm-2026-template",
          "rules": [
            {
              "id": "weak-password-hash",
              "name": "weak-password-hash",
              "shortDescription": {
                "text": "weak-password-hash"
              },
              "properties": {
                "tags": [
                  "CWE-328"
                ]
              }
            },
            {
              "id": "attachment-path-traversal",
              "name": "attachment-path-traversal",
              "shortDescription": {
                "text": "attachment-path-traversal"
              },
              "properties": {
                "tags": [
                  "CWE-22"
                ]
              }
            },
            {
              "id": "predictable-reset-token",
              "name": "predictable-reset-token",
              "shortDescription": {
                "text": "predictable-reset-token"
              },
              "properties": {
                "tags": [
                  "CWE-338"
                ]
              }
            },
            {
              "id": "sql-string-format",
              "name": "sql-string-format",
              "shortDescription": {
                "text": "sql-string-format"
              },
              "properties": {
                "tags": [
                  "CWE-89"
                ]
              }
            },
            {
              "id": "hardcoded-service-credential",
              "name": "hardcoded-service-credential",
              "shortDescription": {
                "text": "hardcoded-service-credential"
              },
              "properties": {
                "tags": [
                  "CWE-798"
                ]
              }
            },
            {
              "id": "hardcoded-signing-key",
              "name": "hardcoded-signing-key",
              "shortDescription": {
                "text": "hardcoded-signing-key"
              },
              "properties": {
                "tags": [
                  "CWE-321"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "weak-password-hash",
          "level": "warning",
          "message": {
            "text": "Passwords are stored as unsalted MD5 hashes, which are inexpensive to crack offline. Use a password-hashing function designed to resist brute-force attacks."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/agent_accounts.py"
                },
                "region": {
                  "startLine": 7,
                  "endLine": 7
                }
              }
            }
          ],
          "properties": {
            "class": "weak-crypto"
          }
        },
        {
          "ruleId": "attachment-path-traversal",
          "level": "warning",
          "message": {
            "text": "Request-controlled path components are joined to the attachment directory and opened without constraining the resolved path to that directory. A crafted filename can traverse to and read files outside the attachment tree."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/attachment_read.py"
                },
                "region": {
                  "startLine": 9,
                  "endLine": 10
                }
              }
            }
          ],
          "properties": {
            "class": "path-traversal"
          }
        },
        {
          "ruleId": "predictable-reset-token",
          "level": "warning",
          "message": {
            "text": "Password-reset tokens are generated with Python's non-cryptographic `random` generator. Use a cryptographically secure random source so attackers cannot predict valid reset tokens."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/reset_tokens.py"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 10
                }
              }
            }
          ],
          "properties": {
            "class": "weak-crypto"
          }
        },
        {
          "ruleId": "sql-string-format",
          "level": "warning",
          "message": {
            "text": "The search term and limit are interpolated directly into SQL text. Attacker-controlled input can alter the query; use bound parameters."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/ticket_search.py"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 10
                }
              }
            }
          ],
          "properties": {
            "class": "injection"
          }
        },
        {
          "ruleId": "hardcoded-service-credential",
          "level": "warning",
          "message": {
            "text": "The backup command embeds a fixed service-account credential in the script. Store the credential in a secret manager or inject it securely at runtime."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/config/backup.sh"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        },
        {
          "ruleId": "hardcoded-signing-key",
          "level": "warning",
          "message": {
            "text": "A private report-signing key is embedded in the source file. Anyone who obtains the source can use the key to forge signed reports; load it from protected secret storage instead."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/config/signing_key.py"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 11
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        }
      ],
      "properties": {
        "model": "Copilot SDK general-purpose agent (underlying model not disclosed)",
        "route": "local",
        "model_self_reported": "not explicitly available"
      }
    }
  ]
}
